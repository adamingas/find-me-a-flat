FROM ghcr.io/astral-sh/uv:0.12.23 AS uv
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble

COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    tigervnc-standalone-server tigervnc-tools novnc websockify \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV UV_NO_SYNC=true PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --extra browser --no-install-project --python /usr/bin/python3
COPY src ./src
RUN uv sync --locked --no-dev --extra browser --no-editable --python /usr/bin/python3 \
    && mkdir -p /state /home/openrent-browser \
    && chown 1000:1000 /state /home/openrent-browser
ENV HOME=/home/openrent-browser
USER 1000:1000
EXPOSE 5800 8091
ENTRYPOINT ["/app/.venv/bin/python", "-m", "openrent.browser_worker"]
